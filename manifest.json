{
  "manifest_version": 3,
  "name": "Tab Switcher",
  "version": "0.2.0",
  "minimum_chrome_version": "127",
  "description": "Search, switch to, and restore Chrome tabs from a keyboard-first switcher.",
  "permissions": [
    "tabs",
    "storage",
    "sessions",
    "activeTab",
    "scripting",
    "favicon"
  ],
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Tab Switcher",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "32": "src/icons/icon-32.png"
    },
    "default_popup": "src/switcher.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/switcher.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "options_page": "src/options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      }
    },
    "open-switcher-alt-windows": {
      "suggested_key": {
        "default": "Alt+E",
        "mac": "Option+E",
        "windows": "Alt+E"
      },
      "description": "Open the tab switcher"
    },
    "switch-previous-tab": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Option+Q"
      },
      "description": "Cycle to the next older most recently used tab"
    },
    "switch-next-tab": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Option+Shift+Q"
      },
      "description": "Cycle to the next newer most recently used tab"
    }
  }
}
